.post-block:has(.home-modules) {
  .post-title,
  .post-meta {
    display: none;
  }
}

// Homepage module cards
.home-hero {
  margin: 0 0 2rem;
  padding-bottom: 1.25rem;
  border-bottom: 1px solid #e5e5e5;
}

.home-hero__eyebrow {
  margin: 0 0 0.5rem;
  color: #888;
  font-size: 0.85rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.home-hero__title {
  margin: 0 0 0.75rem;
  font-size: 1.6rem;
  font-weight: 650;
  line-height: 1.4;
}

.home-hero__desc {
  margin: 0;
  color: #666;
  line-height: 1.7;
}

.home-modules {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  margin: 0 0 2rem;
}

@media (min-width: 768px) {
  .home-modules {
    grid-template-columns: repeat(3, 1fr);
  }
}

.home-module {
  display: block;
  padding: 1.25rem 1.1rem;
  border: 1px solid #e8e8e8;
  border-radius: 8px;
  background: linear-gradient(180deg, #fafafa 0%, #fff 100%);
  color: inherit;
  text-decoration: none !important;
  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.home-module:hover {
  border-color: #222;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  transform: translateY(-2px);
}

.home-module__index {
  display: block;
  margin-bottom: 0.75rem;
  color: #999;
  font-size: 0.85rem;
  letter-spacing: 0.06em;
}

.home-module__title {
  margin: 0 0 0.75rem;
  font-size: 1.15rem;
  font-weight: 650;
}

.home-module__desc {
  margin: 0 0 1rem;
  color: #666;
  font-size: 0.95rem;
  line-height: 1.7;
}

.home-module__link {
  color: #222;
  font-size: 0.9rem;
  font-weight: 600;
}

.home-secondary {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  padding-top: 0.5rem;
}

.home-secondary a {
  color: #555;
  text-decoration: none;
  border-bottom: 1px solid #ddd;
}

.home-secondary a:hover {
  color: #111;
  border-bottom-color: #111;
}

// Sidebar column navigation
.column-nav {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid #eee;
}

.column-nav__title {
  margin-bottom: 0.75rem;
  color: #999;
  font-size: 0.8rem;
  letter-spacing: 0.06em;
}

.column-nav__item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0.35rem 0;
  color: #555;
  text-decoration: none !important;
}

.column-nav__item:hover {
  color: #111;
}

.column-nav__item i {
  width: 1.1rem;
  text-align: center;
}

// Flagship project entry
.home-flagship {
  display: grid;
  gap: 0.45rem;
  margin: 0 0 1.5rem;
  padding: 1.2rem 1.3rem;
  border: 1px solid #dce5ee;
  border-radius: 8px;
  background: linear-gradient(135deg, #f4f8fc 0%, #fff 70%);
  color: inherit;
  text-decoration: none !important;
}

.home-flagship:hover {
  border-color: #71869a;
  box-shadow: 0 6px 18px rgba(29, 54, 79, 0.08);
}

.home-flagship__label,
.project-feature__eyebrow,
.evidence-block__label,
.metric-block__label {
  color: #71869a;
  font-size: 0.78rem;
  font-weight: 650;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.home-flagship__title {
  font-size: 1.15rem;
  font-weight: 650;
}

.home-flagship__desc {
  color: #666;
  line-height: 1.65;
}

.home-flagship__link {
  color: #222;
  font-size: 0.9rem;
  font-weight: 600;
}

// Project presentation
.project-feature {
  margin: 1.25rem 0 2rem;
  padding: 1.35rem;
  border: 1px solid #dfe6ec;
  border-radius: 10px;
  background: #fbfcfd;
}

.project-feature__header,
.project-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.project-feature__header h3,
.project-card__header h3 {
  margin-top: 0.3rem;
}

.project-status {
  flex: 0 0 auto;
  padding: 0.22rem 0.6rem;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 600;
}

.project-status--active {
  background: #e5f2eb;
  color: #2e6847;
}

.project-status--stable {
  background: #e8eef6;
  color: #3d5f82;
}

.project-status--planned {
  background: #f1eee8;
  color: #76664d;
}

.visual-card-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  margin: 1rem 0 2rem;
}

.visual-card {
  display: flex;
  flex-direction: column;
  min-height: 190px;
  padding: 1.2rem;
  border: 1px solid #e1e6ea;
  border-radius: 9px;
  background: #fff;
  color: inherit;
  text-decoration: none !important;
  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.visual-card:hover,
.visual-card:focus-visible {
  border-color: #71869a;
  box-shadow: 0 6px 18px rgba(29, 54, 79, 0.08);
  transform: translateY(-2px);
}

.visual-card:focus-visible {
  outline: 2px solid #71869a;
  outline-offset: 3px;
}

.visual-card--active {
  border-color: #b9c9d7;
  background: #fbfcfd;
}

.visual-card--compact {
  min-height: 155px;
}

.visual-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.8rem;
}

.visual-card__eyebrow {
  color: #71869a;
  font-size: 0.76rem;
  font-weight: 650;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.visual-card h3 {
  margin: 0.75rem 0 0.55rem;
  font-size: 1.08rem;
}

.visual-card p {
  margin: 0;
  color: #666;
  line-height: 1.65;
}

.visual-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.9rem;
}

.visual-card__tags span {
  padding: 0.18rem 0.48rem;
  border-radius: 999px;
  background: #f1f4f6;
  color: #58636d;
  font-size: 0.75rem;
}

.visual-card__action {
  margin-top: auto;
  padding-top: 1rem;
  color: #31475b;
  font-size: 0.88rem;
}

.project-plan-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
  padding: 1.35rem;
  border: 1px solid #dfe6ec;
  border-radius: 10px;
  background: #fbfcfd;
}

.project-plan-hero h2 {
  margin: 0.35rem 0 0.65rem;
}

.project-plan-hero p:last-child {
  margin-bottom: 0;
  color: #5f6972;
  line-height: 1.7;
}

.pipeline-flow {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 1rem 0 1.5rem;
  padding: 1rem;
  border: 1px solid #e2e7eb;
  border-radius: 8px;
  background: #f7f9fa;
}

.pipeline-flow span {
  padding: 0.35rem 0.55rem;
  border-radius: 5px;
  background: #fff;
  color: #43505b;
  font-size: 0.84rem;
}

.pipeline-flow b {
  color: #82909c;
  font-weight: 500;
}

.project-grid,
.evidence-grid,
.metric-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

.project-card {
  padding: 1.2rem;
  border: 1px solid #e4e7ea;
  border-radius: 8px;
  background: #fff;
}

.project-card__summary {
  color: #555;
  line-height: 1.7;
}

.project-card__facts {
  margin: 1rem 0;
}

.project-card__facts dt {
  margin-top: 0.7rem;
  color: #333;
  font-size: 0.85rem;
  font-weight: 650;
}

.project-card__facts dd {
  margin: 0.2rem 0 0;
  color: #666;
  line-height: 1.65;
}

.project-card__links,
.project-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem 1rem;
  margin-top: 1rem;
}

.project-card__links a,
.project-actions a {
  font-weight: 600;
  text-decoration: none;
}

.evidence-grid,
.metric-grid {
  margin: 1.2rem 0;
}

.evidence-block,
.metric-block {
  padding: 1rem;
  border-left: 3px solid #91a7ba;
  background: #f4f7f9;
}

.evidence-block strong,
.metric-block strong {
  display: block;
  margin: 0.4rem 0;
}

.evidence-block p,
.metric-block p {
  margin: 0;
  color: #666;
  line-height: 1.65;
}

.project-boundary {
  margin-top: 1rem;
  padding: 1rem;
  border-radius: 6px;
  background: #f7f3eb;
}

.project-boundary p {
  margin: 0.35rem 0 0;
}

.project-media {
  margin: 1.25rem 0;
}

.project-media img {
  display: block;
  width: 100%;
  border-radius: 8px;
}

.project-media figcaption {
  margin-top: 0.55rem;
  color: #777;
  font-size: 0.85rem;
  line-height: 1.6;
}

@media (min-width: 768px) {
  .visual-card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .visual-card-grid--primary {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .project-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .evidence-grid,
  .metric-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 767px) {
  .project-feature,
  .project-card {
    padding: 1rem;
  }

  .project-feature__header,
  .project-card__header,
  .visual-card__header,
  .project-plan-hero {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.4rem;
  }
}
