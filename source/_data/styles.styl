.post-block:has(.home-modules) {
  .post-title,
  .post-meta {
    display: none;
  }
}

// Homepage module cards
.home-hero {
  margin: 0 0 2rem;
  padding-bottom: 1.25rem;
  border-bottom: 1px solid #e5e5e5;
}

.home-hero__eyebrow {
  margin: 0 0 0.5rem;
  color: #888;
  font-size: 0.85rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.home-hero__title {
  margin: 0 0 0.75rem;
  font-size: 1.6rem;
  line-height: 1.4;
}

.home-hero__desc {
  margin: 0;
  color: #666;
  line-height: 1.7;
}

.home-modules {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  margin: 0 0 2rem;
}

@media (min-width: 768px) {
  .home-modules {
    grid-template-columns: repeat(3, 1fr);
  }
}

.home-module {
  display: block;
  padding: 1.25rem 1.1rem;
  border: 1px solid #e8e8e8;
  border-radius: 8px;
  background: linear-gradient(180deg, #fafafa 0%, #fff 100%);
  color: inherit;
  text-decoration: none !important;
  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.home-module:hover {
  border-color: #222;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  transform: translateY(-2px);
}

.home-module__index {
  display: block;
  margin-bottom: 0.75rem;
  color: #999;
  font-size: 0.85rem;
  letter-spacing: 0.06em;
}

.home-module__title {
  margin: 0 0 0.75rem;
  font-size: 1.15rem;
}

.home-module__desc {
  margin: 0 0 1rem;
  color: #666;
  font-size: 0.95rem;
  line-height: 1.7;
}

.home-module__link {
  color: #222;
  font-size: 0.9rem;
  font-weight: 600;
}

.home-secondary {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  padding-top: 0.5rem;
}

.home-secondary a {
  color: #555;
  text-decoration: none;
  border-bottom: 1px solid #ddd;
}

.home-secondary a:hover {
  color: #111;
  border-bottom-color: #111;
}

// Sidebar column navigation
.column-nav {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid #eee;
}

.column-nav__title {
  margin-bottom: 0.75rem;
  color: #999;
  font-size: 0.8rem;
  letter-spacing: 0.06em;
}

.column-nav__item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0.35rem 0;
  color: #555;
  text-decoration: none !important;
}

.column-nav__item:hover {
  color: #111;
}

.column-nav__item i {
  width: 1.1rem;
  text-align: center;
}
